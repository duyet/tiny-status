{
  "pollSeconds": 30,
  "alerts": {
    "enabled": true,
    "onDown": true,
    "onRecover": true,
    "cooldownSeconds": 300
  },
  "backup": {
    "enabled": true,
    "autoOnSave": false,
    "repo": "{home}/.config/tiny-status/git-backup",
    "file": "tunnels.json",
    "remote": "origin",
    "branch": "main",
    "remoteUrl": ""
  },
  "checks": [
    {
      "id": "web",
      "title": "Web",
      "kind": "http",
      "url": "https://example.com/health"
    },
    {
      "id": "web-discover",
      "title": "Web (discover)",
      "kind": "http",
      "url": "https://example.com",
      "discover": true
    },
    {
      "id": "redis",
      "title": "Redis",
      "kind": "tcp",
      "host": "127.0.0.1",
      "port": 6379
    },
    {
      "id": "ssh",
      "title": "Tunnel",
      "kind": "tcp",
      "host": "127.0.0.1",
      "port": 8443
    },
    {
      "id": "ts",
      "title": "Peer",
      "kind": "tcp",
      "host": "my-machine.tailnet.ts.net",
      "port": 22
    },
    {
      "id": "cmd",
      "title": "Custom",
      "kind": "command",
      "command": ["/usr/bin/true"]
    }
  ]
}
