{
  "pollSeconds": 30,
  "vars": {
    "host": "example.com",
    "health": "https://{host}/health"
  },
  "checks": [
    { "id": "web", "title": "Web", "kind": "http", "url": "{health}" },
    { "id": "redis", "title": "Redis", "kind": "tcp", "host": "127.0.0.1", "port": 6379 },
    {
      "id": "ssh",
      "title": "Tunnel",
      "kind": "tcp",
      "host": "127.0.0.1",
      "port": 8443,
      "icon": "lock.shield",
      "group": "Tunnel",
      "tags": ["Tunnel"],
      "actions": [
        { "id": "start", "title": "Start", "when": "down", "icon": "play.fill", "command": ["/usr/bin/true"] },
        { "id": "stop", "title": "Stop", "when": "up", "icon": "stop.fill", "command": ["/usr/bin/true"] },
        { "id": "open", "title": "Open", "when": "up", "url": "https://example.com" }
      ]
    },
    { "id": "ts", "title": "Peer", "kind": "tcp", "host": "my-machine.tailnet.ts.net", "port": 22 },
    { "id": "cmd", "title": "Custom", "kind": "command", "command": ["/usr/bin/true"] },
    { "id": "paused", "title": "Paused", "kind": "tcp", "host": "127.0.0.1", "port": 9, "enabled": false }
  ]
}
